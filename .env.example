# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=likeminds

# Long random string used to sign login cookies (at least 16 characters)
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that can open /admin (review queue, organizer approvals)
ADMIN_EMAILS=admin@likeminds.test

# Optional: enables AI moderation, translation, and prompt-theme summaries.
# Without a key, the app uses built-in rule-based moderation and similarity matching.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Google Maps (recommended). Enable "Maps JavaScript API", "Places API (New)", and "Geocoding API"
# in Google Cloud, then restrict the key to your site's URLs (HTTP referrers).
# Without a key the app falls back to OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# A Map ID is required for the custom bubble markers. DEMO_MAP_ID works for development.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
